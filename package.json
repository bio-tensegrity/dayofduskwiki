{
  "name": "day-of-dusk-wiki",
  "version": "1.0.0",
  "description": "The official wiki for Day of Dusk: The Border - A Roblox game",
  "scripts": {
    "dev": "hugo server -D",
    "build": "hugo --minify",
    "postcss:watch": "postcss themes/dod-wiki/static/css/tailwind.css -o themes/dod-wiki/static/css/tailwind.min.css --watch",
    "postcss:build": "postcss themes/dod-wiki/static/css/tailwind.css -o themes/dod-wiki/static/css/tailwind.min.css"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "postcss-cli": "^10.1.0",
    "tailwindcss": "^3.3.6"
  }
} 